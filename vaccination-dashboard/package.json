{
  "name": "vaccination-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed:generate": "tsx lib/seed-generator.ts",
    "seed:apply": "rm -f data/vaccinations.db && sqlite3 data/vaccinations.db < data/schema.sql && sqlite3 data/vaccinations.db < data/seed.sql",
    "seed": "npm run seed:generate && npm run seed:apply"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "better-sqlite3": "^12.9.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
